{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rwp-ai-gateway",
  "main": "ai-gateway.ts",
  "compatibility_date": "2026-10-27",
  "vars": {
    "ALLOWED_ORIGIN": "https://orgonag.github.io",
    "OPENAI_MODEL": "gpt-4.1-mini"
  },
  "ratelimits": [{
    "name": "AI_RATE_LIMITER",
    "namespace_id": "1001",
    "simple": { "limit": 5, "period": 60 }
  }]
}
